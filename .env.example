PORT=5000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-token-replace-in-production
JWT_EXPIRES_IN=7d
DB_PATH=./data/life_pms.db
UPLOAD_DIR=./data/uploads

# Firebase Configuration
FIREBASE_PROJECT_ID=zoho-cda77
FIREBASE_AUTH_DOMAIN=zoho-cda77.firebaseapp.com
FIREBASE_STORAGE_BUCKET=zoho-cda77.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=

# Base URLs & Security
APP_BASE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5000,https://dainty-bubblegum-a8f269.netlify.app
ALLOW_ETHEREAL=false

# SMTP Real Email Settings (Option A: Custom SMTP e.g. SendGrid, Resend, Mailgun, AWS SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Life PMS <notifications@yourdomain.com>"

# Option B: Direct Gmail SMTP with Google 16-character App Password
GMAIL_USER=
GMAIL_APP_PASSWORD=
