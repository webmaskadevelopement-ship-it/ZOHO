rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null && (request.auth.token.email != null || request.auth.uid != null);
    }
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'webmaskadevelopement@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin')
      );
    }
    function isManagerOrAdmin() {
      return isAdmin() || (
        isAuthenticated() && (
          request.auth.token.email == 'backend.webmaska@gmail.com' ||
          (exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
           get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'manager')
        )
      );
    }

    // Users can read and write their own data tree (Step 4 of Cross-Device Sync)
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    // In-app requests & collaboration invitations
    match /in_app_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    match /invited_members/{inviteId} {
      // Sensitive invitation records & token hashes are restricted to managers and administrators
      allow read, write: if isManagerOrAdmin();
    }
    match /submitted_emails/{submissionId} {
      // Public forms can submit leads/emails with field validation, but only managers/admins can read them
      allow read: if isManagerOrAdmin();
      allow create: if request.resource.data.email is string && request.resource.data.email.size() <= 320;
      allow update, delete: if isManagerOrAdmin();
    }
    match /projects/{projectId} {
      allow read, write: if isAuthenticated();
    }
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }
    match /timesheets/{logId} {
      allow read, write: if isAuthenticated();
    }
    match /issues/{issueId} {
      allow read, write: if isAuthenticated();
    }
    match /portals/{portalId}/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
