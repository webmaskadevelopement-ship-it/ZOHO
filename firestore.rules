rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null && (request.auth.token.email != null || request.auth.uid != null);
    }
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'webmaskadevelopement@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin')
      );
    }
    function isManagerOrAdmin() {
      return isAdmin() || (
        isAuthenticated() && (
          request.auth.token.email == 'backend.webmaska@gmail.com' ||
          (exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
           get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'manager')
        )
      );
    }

    // Users can read basic profiles, only Backend Admin SDK writes roles/connections
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if false; // Managed strictly via Express Backend API
    }

    // Users can listen to their own real-time notifications
    match /users/{userId}/notifications/{notifId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == userId);
      allow write: if false; // Managed strictly via Express Backend API
    }

    // Users can read requests where they are sender or receiver; all writes go through Backend API
    match /in_app_requests/{requestId} {
      allow read: if request.auth != null &&
        (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid ||
         resource.data.senderEmail == request.auth.token.email || resource.data.receiverEmail == request.auth.token.email);
      allow write: if false; // Enforces RBAC & atomic transactions via /api/v1/requests
    }

    match /invited_members/{inviteId} {
      // Sensitive invitation records & token hashes are restricted to managers and administrators
      allow read, write: if isManagerOrAdmin();
    }
    match /submitted_emails/{submissionId} {
      // Public forms can submit leads/emails with field validation, but only managers/admins can read them
      allow read: if isManagerOrAdmin();
      allow create: if request.resource.data.email is string && request.resource.data.email.size() <= 320;
      allow update, delete: if isManagerOrAdmin();
    }
    match /projects/{projectId} {
      allow read, write: if isAuthenticated();
    }
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }
    match /timesheets/{logId} {
      allow read, write: if isAuthenticated();
    }
    match /issues/{issueId} {
      allow read, write: if isAuthenticated();
    }
    match /portals/{portalId}/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
